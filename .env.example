# Copy to .env.local for local development. Never commit real values.
# Live mode is shown only when BOTH ANTHROPIC_API_KEY and LIVE_ACCESS_CODE are set.

# Claude API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=
# Model used in live mode (optional, defaults to claude-opus-5-5)
ANTHROPIC_MODEL=

# Access code visitors enter to unlock live mode
LIVE_ACCESS_CODE=
# Secret used to sign the live-mode cookie (optional, falls back to LIVE_ACCESS_CODE).
# Generate one with: openssl rand -hex 32
LIVE_SESSION_SECRET=

# Live requests allowed per visitor IP per hour (optional, default 10)
LIVE_RATE_LIMIT_PER_HOUR=

# Optional shared rate-limit store (Upstash Redis REST). Without it, limits are
# kept in memory per server instance, which is weaker on serverless hosting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used for canonical and Open Graph URLs (optional)
NEXT_PUBLIC_SITE_URL=
